TARNMEDIA_ADDR=:8088

# Shared with the application that issues media tokens. At least 32 characters.
TARNMEDIA_JWT_SECRET=replace-with-the-same-long-secret-as-your-application
# Expected `iss` claim of those tokens.
TARNMEDIA_ISSUER=tarnveil-server

# Control API + /metrics. Loopback only; startup fails otherwise.
TARNMEDIA_CONTROL_ADDR=127.0.0.1:8089
TARNMEDIA_CONTROL_SECRET=replace-with-the-same-control-secret-as-your-application

# Your session-validation endpoint. 204 admits the participant, anything else
# rejects it. Must be HTTPS or loopback HTTP.
TARNMEDIA_AUTH_URL=http://127.0.0.1:3001/internal/tarnmedia/validate

# Exact scheme+host allowlist for browsers. Replace with your own origins.
TARNMEDIA_ALLOWED_ORIGINS=https://app.example,http://localhost:5173,http://127.0.0.1:5173

# Address advertised in ICE candidates when behind NAT.
TARNMEDIA_PUBLIC_IP=
TARNMEDIA_UDP_MIN=50000
TARNMEDIA_UDP_MAX=50100

# Optional own STUN/TURN endpoints, comma-separated. No third-party server is used by default.
TARNMEDIA_ICE_URLS=
TARNMEDIA_ICE_USERNAME=
TARNMEDIA_ICE_CREDENTIAL=

TARNMEDIA_MAX_PEERS_PER_ROOM=25
